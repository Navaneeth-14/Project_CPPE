# Copy this file to .env and fill in your values

# GenAI provider: "groq" (default) | "openai" | "anthropic"
GENAI_PROVIDER=groq

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use — Groq free-tier options:
#   openai/gpt-oss-20b    (1000 t/s, fast — default)
#   openai/gpt-oss-120b   (500 t/s, higher quality)
GENAI_MODEL=openai/gpt-oss-20b


# FastAPI server config
API_HOST=127.0.0.1
API_PORT=8000
# Secret key for JWT signing — change this to a long random string in production
SECRET_KEY=local-dev-secret-change-in-prod

# Data directories (relative to project root)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
